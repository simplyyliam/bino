{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@bino/types": ["packages/types/src/index.ts"],
      "@bino/types/*": ["packages/types/src/*"],
      "@bino/ui": ["packages/ui/src/index.ts"],
      "@bino/ui/*": ["packages/ui/src/*"],
      "@bino/data": ["packages/data/src/index.ts"],
      "@bino/data/*": ["packages/data/src/*"]
    }
  }
}
